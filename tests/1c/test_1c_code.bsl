// ============================================================================
// Тест драйвера «Дисплей покупателя (монитор)» — вставить в консоль кода
// (или во внешнюю обработку) и выполнить В СЕАНСЕ ПРЕДПРИЯТИЯ.
// Сам подбирает рабочий вариант имени типа и выводит диагностику.
// ============================================================================

ФайлКомпоненты = "C:\Users\admin\Documents\displaynativeapi\CustomerDisplayNative.zip";

// --- Шаг 1. Подключение компоненты из zip ---
Ок = Неопределено;
Попытка
	Ок = ПодключитьВнешнююКомпоненту(ФайлКомпоненты, "CDN", ТипВнешнейКомпоненты.Native);
	Сообщить("ПодключитьВнешнююКомпоненту = " + Ок);
Исключение
	Сообщить("ПодключитьВнешнююКомпоненту ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки());
КонецПопытки;

// --- Шаг 2. Создание объекта: перебираем варианты имени типа ---
Компонента = Неопределено;
Если Ок = Истина Тогда
	Варианты = Новый Массив;
	Варианты.Добавить("AddIn.CDN.CustomerDisplay");
	Варианты.Добавить("AddIn.CustomerDisplayNative.CustomerDisplay");
	Варианты.Добавить("AddIn.CustomerDisplayNative");          // короткая форма (как у рабочего драйвера)
	Варианты.Добавить("AddIn.CDN.CustomerDisplayNative");

	Для Каждого ИмяТипа Из Варианты Цикл
		Попытка
			Компонента = Новый(ИмяТипа);
			Сообщить("РАБОЧИЙ ТИП: " + ИмяТипа);
			Прервать;
		Исключение
			Сообщить("не подошёл: " + ИмяТипа);
		КонецПопытки;
	КонецЦикла;
КонецЕсли;

Если Компонента = Неопределено Тогда
	Сообщить("!!! Компонента не создана. Пришлите этот вывод.");
	Возврат;
КонецЕсли;

// --- Шаг 3. Подключение устройства (монитор №2, 1 — основной) ---
ИдентификаторУстройства = "";
ПараметрыПодключения =
	"<Parameters>"
	+ "<Parameter Name=""MonitorIndex"" Value=""2""/>"
	+ "<Parameter Name=""Fullscreen"" Value=""true""/>"
	+ "</Parameters>";

Если НЕ Компонента.ConnectEquipment(ИдентификаторУстройства, "CustomerDisplay", ПараметрыПодключения) Тогда
	ОписаниеОшибки = "";
	Компонента.GetLastError(ОписаниеОшибки);
	Сообщить("ConnectEquipment ОШИБКА: " + ОписаниеОшибки);
	Возврат;
КонецЕсли;
Сообщить("Дисплей подключён, DeviceID = " + ИдентификаторУстройства);

// --- Шаг 4. Демонстрация экранов ---
Компонента.StringOutputOnCustomerDisplay(ИдентификаторУстройства,
	"<Strings>"
	+ "<String>Молоко 3,2% 1 л | 89,90</String>"
	+ "<String>Хлеб «Бородинский» | 54,50</String>"
	+ "<String>Сыр «Российский» 500 г | 349,90</String>"
	+ "<String>ИТОГО | 494,30</String>"
	+ "</Strings>");
Сообщить("Строки выведены. Смотрите монитор №2.");

