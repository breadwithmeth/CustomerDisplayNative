&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Отказ = Истина; // форму не показываем — тест выполняется без интерфейса

	Лог = "";
	Ошибок = 0;

	ФайлКомпоненты = "C:\Users\admin\Documents\displaynativeapi\CustomerDisplayNative.zip";
	ФайлЭталона    = "C:\Users\admin\Documents\displaynativeapi\ref\kaspi1729.zip";

	// --- Пробуем разные варианты имён типа и пишем ВСЕ результаты ---
	СписокВариантов = Новый Массив;
	СписокВариантов.Добавить("AddIn.CDN.CustomerDisplay");
	СписокВариантов.Добавить("AddIn.CustomerDisplayNative.CustomerDisplay");
	СписокВариантов.Добавить("AddIn.CDN.CustomerDisplayNative");
	СписокВариантов.Добавить("AddIn.CustomerDisplayNative");

	Компонента = Неопределено;

	// вариант 1: zip по пути
	ПодключенаИзФайла = Неопределено;
	Попытка
		ПодключенаИзФайла = ПодключитьВнешнююКомпоненту(ФайлКомпоненты, "CDN", ТипВнешнейКомпоненты.Native);
		Лог = Лог + "[..] ПодключитьВнешнююКомпоненту(zip-файл) = " + ПодключенаИзФайла + Символы.ПС;
	Исключение
		Лог = Лог + "[FAIL] ПодключитьВнешнююКомпоненту(zip-файл): " + ОписаниеОшибки() + Символы.ПС;
	КонецПопытки;

	Если ПодключенаИзФайла = Истина Тогда
		Для Каждого ИмяТипа Из СписокВариантов Цикл
			Попытка
				Компонента = Новый(ИмяТипа);
				Лог = Лог + "[OK] Новый " + ИмяТипа + Символы.ПС;
				Прервать;
			Исключение
				Лог = Лог + "[FAIL] Новый " + ИмяТипа + Символы.ПС;
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	// вариант 2: двоичные данные zip во временном хранилище
	Если Компонента = Неопределено Тогда
		Попытка
			Данные = Новый ДвоичныеДанные(ФайлКомпоненты);
			Адрес = ПоместитьВоВременноеХранилище(Данные);
			Ок = ПодключитьВнешнююКомпоненту(Адрес, "CDN2", ТипВнешнейКомпоненты.Native);
			Лог = Лог + "[..] ПодключитьВнешнююКомпоненту(адрес zip) = " + Ок + Символы.ПС;
			Если Ок Тогда
				Для Каждого ИмяТипа Из СписокВариантов Цикл
					Попытка
						Компонента = Новый(ИмяТипа);
						Лог = Лог + "[OK] Новый " + ИмяТипа + " (из адреса)" + Символы.ПС;
						Прервать;
					Исключение
						Лог = Лог + "[FAIL] Новый " + ИмяТипа + " (из адреса)" + Символы.ПС;
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] Подключение из адреса: " + ОписаниеОшибки() + Символы.ПС;
		КонецПопытки;
	КонецЕсли;

	// вариант 3: DLL напрямую по пути (мимо манифеста)
	Если Компонента = Неопределено Тогда
		Попытка
			ПутьDLL = "C:\Users\admin\Documents\displaynativeapi\bin\Release\CustomerDisplayNative_64.dll";
			Ок = ПодключитьВнешнююКомпоненту(ПутьDLL, "CDN3", ТипВнешнейКомпоненты.Native);
			Лог = Лог + "[..] ПодключитьВнешнююКомпоненту(DLL напрямую) = " + Ок + Символы.ПС;
			Если Ок Тогда
				Для Каждого ИмяТипа Из СписокВариантов Цикл
					Попытка
						Компонента = Новый(ИмяТипа);
						Лог = Лог + "[OK] Новый " + ИмяТипа + " (DLL напрямую)" + Символы.ПС;
						Прервать;
					Исключение
						Лог = Лог + "[FAIL] Новый " + ИмяТипа + " (DLL напрямую)" + Символы.ПС;
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] Подключение DLL напрямую: " + ОписаниеОшибки() + Символы.ПС;
		КонецПопытки;
	КонецЕсли;

	// вариант 4: ЭТАЛОННЫЙ рабочий драйвер — проверяем схему подключения на нём
	Лог = Лог + "--- Эталонный драйвер kaspi1729 ---" + Символы.ПС;
	ЭталонаПодключена = Неопределено;
	Попытка
		ЭталонаПодключена = ПодключитьВнешнююКомпоненту(ФайлЭталона, "REF", ТипВнешнейКомпоненты.Native);
		Лог = Лог + "[..] ПодключитьВнешнююКомпоненту(эталон) = " + ЭталонаПодключена + Символы.ПС;
	Исключение
		Лог = Лог + "[FAIL] ПодключитьВнешнююКомпоненту(эталон): " + ОписаниеОшибки() + Символы.ПС;
	КонецПопытки;
	Если ЭталонаПодключена = Истина Тогда
		Для Каждого ИмяТипа Из "AddIn.InnovaIT,AddIn.REF.innNative,AddIn.REF.InnovaIT,AddIn.InnovaIT.innNative" Цикл
			Попытка
				РефКомпонента = Новый(ИмяТипа);
				Лог = Лог + "[OK] ЭТАЛОН: Новый " + ИмяТипа + Символы.ПС;
				РефКомпонента = Неопределено;
				Прервать;
			Исключение
				Лог = Лог + "[FAIL] ЭТАЛОН: Новый " + ИмяТипа + Символы.ПС;
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	Если Компонента = Неопределено Тогда
		Ошибок = Ошибок + 1;
	КонецЕсли;

	Если Компонента = Неопределено Тогда
		// вариант 3: подключение DLL напрямую по пути (мимо манифеста)
		Попытка
			ПутьDLL = "C:\Users\admin\Documents\displaynativeapi\bin\Release\CustomerDisplayNative_64.dll";
			Ок = ПодключитьВнешнююКомпоненту(ПутьDLL, "CDN3", ТипВнешнейКомпоненты.Native);
			Лог = Лог + "[..] ПодключитьВнешнююКомпоненту(DLL напрямую) = " + Ок + Символы.ПС;
			Если Ок Тогда
				Для Каждого ИмяТипа Из "AddIn.CDN3.CustomerDisplay,AddIn.CustomerDisplayNative.CustomerDisplay" Цикл
					Попытка
						Компонента = Новый(ИмяТипа);
						Лог = Лог + "[OK] Новый " + ИмяТипа + Символы.ПС;
						Прервать;
					Исключение
						Лог = Лог + "[FAIL] Новый " + ИмяТипа + ": " + ОписаниеОшибки() + Символы.ПС;
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] Подключение DLL напрямую: " + ОписаниеОшибки() + Символы.ПС;
		КонецПопытки;
	КонецЕсли;

	Если Компонента = Неопределено Тогда
		Ошибок = Ошибок + 1;
	КонецЕсли;

	Если Ошибок = 0 Тогда
		// --- GetInterfaceRevision ---
		Попытка
			Ревизия = Компонента.GetInterfaceRevision();
			Если Ревизия = 4008 Тогда
				Лог = Лог + "[OK] GetInterfaceRevision = 4008" + Символы.ПС;
			Иначе
				Лог = Лог + "[FAIL] GetInterfaceRevision = " + Ревизия + Символы.ПС;
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] GetInterfaceRevision: " + ОписаниеОшибки() + Символы.ПС;
			Ошибок = Ошибок + 1;
		КонецПопытки;

		// --- GetDescription ---
		Попытка
			ОписаниеДрайвера = "";
			Ок = Компонента.GetDescription(ОписаниеДрайвера);
			Если Ок И СтрНайти(ОписаниеДрайвера, "CustomerDisplay") > 0 Тогда
				Лог = Лог + "[OK] GetDescription (CustomerDisplay в XML)" + Символы.ПС;
			Иначе
				Лог = Лог + "[FAIL] GetDescription: " + ОписаниеДрайвера + Символы.ПС;
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] GetDescription: " + ОписаниеОшибки() + Символы.ПС;
			Ошибок = Ошибок + 1;
		КонецПопытки;

		// --- EquipmentParameters ---
		Попытка
			ПараметрыXML = "";
			Ок = Компонента.EquipmentParameters("CustomerDisplay", ПараметрыXML);
			Если Ок И СтрНайти(ПараметрыXML, "MonitorIndex") > 0 Тогда
				Лог = Лог + "[OK] EquipmentParameters (MonitorIndex в XML)" + Символы.ПС;
			Иначе
				Лог = Лог + "[FAIL] EquipmentParameters: " + ПараметрыXML + Символы.ПС;
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] EquipmentParameters: " + ОписаниеОшибки() + Символы.ПС;
			Ошибок = Ошибок + 1;
		КонецПопытки;

		// --- Подключение устройства (монитор 1) ---
		ИдентификаторУстройства = "";
		Попытка
			ПараметрыПодключения = "<Parameters><Parameter Name=""MonitorIndex"" Value=""1""/></Parameters>";
			Ок = Компонента.ConnectEquipment(ИдентификаторУстройства, "CustomerDisplay", ПараметрыПодключения);
			Если Ок И ЗначениеЗаполнено(ИдентификаторУстройства) Тогда
				Лог = Лог + "[OK] ConnectEquipment, DeviceID=" + ИдентификаторУстройства + Символы.ПС;
			Иначе
				ОписаниеОшибкиПодключения = "";
				Компонента.GetLastError(ОписаниеОшибкиПодключения);
				Лог = Лог + "[FAIL] ConnectEquipment: " + ОписаниеОшибкиПодключения + Символы.ПС;
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] ConnectEquipment: " + ОписаниеОшибки() + Символы.ПС;
			Ошибок = Ошибок + 1;
		КонецПопытки;
	КонецЕсли;

	Если Ошибок = 0 Тогда
		// --- Вывод строк ---
		Попытка
			Строки = "<Strings><String>Товар 1 | 100,00</String><String>Товар 2 | 200,00</String><String>ИТОГО | 300,00</String></Strings>";
			Ок = Компонента.StringOutputOnCustomerDisplay(ИдентификаторУстройства, Строки);
			Если Ок Тогда
				Лог = Лог + "[OK] StringOutputOnCustomerDisplay" + Символы.ПС;
			Иначе
				Лог = Лог + "[FAIL] StringOutputOnCustomerDisplay" + Символы.ПС;
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] StringOutputOnCustomerDisplay: " + ОписаниеОшибки() + Символы.ПС;
			Ошибок = Ошибок + 1;
		КонецПопытки;

		// --- QR-код ---
		Попытка
			Ок = Компонента.QRCodeOutputOnCustomerDisplay(ИдентификаторУстройства, "https://1c.ru/test", "");
			Если Ок Тогда
				Лог = Лог + "[OK] QRCodeOutputOnCustomerDisplay" + Символы.ПС;
			Иначе
				Лог = Лог + "[FAIL] QRCodeOutputOnCustomerDisplay" + Символы.ПС;
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] QRCodeOutputOnCustomerDisplay: " + ОписаниеОшибки() + Символы.ПС;
			Ошибок = Ошибок + 1;
		КонецПопытки;

		// --- Опции дисплея ---
		Попытка
			Опции = "";
			Ок = Компонента.GetCustomerDisplayOptions(ИдентификаторУстройства, Опции);
			Если Ок И СтрНайти(Опции, "DisplayQRCode=""true""") > 0 Тогда
				Лог = Лог + "[OK] GetCustomerDisplayOptions" + Символы.ПС;
			Иначе
				Лог = Лог + "[FAIL] GetCustomerDisplayOptions: " + Опции + Символы.ПС;
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] GetCustomerDisplayOptions: " + ОписаниеОшибки() + Символы.ПС;
			Ошибок = Ошибок + 1;
		КонецПопытки;

		// --- Статус рабочего места ---
		Попытка
			Ок = Компонента.DisplayWorkplaceStatus(ИдентификаторУстройства, 1, 1);
			Если Ок Тогда
				Лог = Лог + "[OK] DisplayWorkplaceStatus" + Символы.ПС;
			Иначе
				Лог = Лог + "[FAIL] DisplayWorkplaceStatus" + Символы.ПС;
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] DisplayWorkplaceStatus: " + ОписаниеОшибки() + Символы.ПС;
			Ошибок = Ошибок + 1;
		КонецПопытки;

		// --- Тест оборудования ---
		Попытка
			ОписаниеТеста = "";
			Ок = Компонента.EquipmentTest("CustomerDisplay", "<Parameters/>", ОписаниеТеста);
			Если Ок Тогда
				Лог = Лог + "[OK] EquipmentTest" + Символы.ПС;
			Иначе
				Лог = Лог + "[FAIL] EquipmentTest" + Символы.ПС;
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] EquipmentTest: " + ОписаниеОшибки() + Символы.ПС;
			Ошибок = Ошибок + 1;
		КонецПопытки;

		// --- Отключение ---
		Попытка
			Ок = Компонента.DisconnectEquipment(ИдентификаторУстройства);
			Если Ок Тогда
				Лог = Лог + "[OK] DisconnectEquipment" + Символы.ПС;
			Иначе
				Лог = Лог + "[FAIL] DisconnectEquipment" + Символы.ПС;
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Лог = Лог + "[FAIL] DisconnectEquipment: " + ОписаниеОшибки() + Символы.ПС;
			Ошибок = Ошибок + 1;
		КонецПопытки;
	КонецЕсли;

	Лог = Лог + Символы.ПС + "ИТОГ: " + ?(Ошибок = 0, "УСПЕХ", "ОШИБОК: " + Ошибок) + Символы.ПС;

	// Сохраняем лог
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(Лог);
	Документ.Записать("C:\Users\admin\Documents\displaynativeapi\tests\1c\result.txt", КодировкаТекста.UTF8);

	ЗавершитьРаботуСистемы(Истина);

КонецПроцедуры
